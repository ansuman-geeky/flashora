# ============================================================
# FLASHORA — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Firebase ---
# Path to your google-services.json (Android)
# Download from Firebase Console → Project Settings → Android app
GOOGLE_SERVICES_JSON=./google-services.json

# --- AdMob ---
# Android App ID from AdMob Console → Apps → App settings
# Test ID (default): ca-app-pub-3940256099942544~3347511713
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713

# iOS App ID from AdMob Console (if building for iOS)
# Test ID (default): ca-app-pub-3940256099942544~1458002511
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511

# --- Ad Unit IDs ---
# App Open Ad — shown on cold launch after 4h gap
ADMOB_APP_OPEN_ID=ca-app-pub-3940256099942544/9257395921

# Native Banner Ad — shown on home screen bottom
ADMOB_NATIVE_BANNER_ID=ca-app-pub-3940256099942544/2247696110

# Interstitial Ad — shown post tool completion (max every 2 actions)
ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712

# Rewarded Ad — user-initiated "Unlock batch trial"
ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917

# --- EAS Build ---
# Expo project ID from expo.dev dashboard
EAS_PROJECT_ID=

# --- URL Shortener ---
# TinyURL API token (optional, works without token for basic usage)
TINYURL_API_TOKEN=

# --- Feature Flags (defaults — overridden by Firebase Remote Config) ---
# These are local fallbacks only. Production values come from Remote Config.
ADS_ENABLED=true
INTERSTITIAL_FREQUENCY=2
REWARDED_ENABLED=true
PREMIUM_PRICE_INR=149
